# copy .env.example .env  (в этой же папке repo\)

# --- Папка с документами (Docker) ---
# HOST_DOCS_DIR — на диске Windows (абсолютный или ./my-docs относительно repo)
HOST_DOCS_DIR=./my-docs
# DOCS_DIR — путь внутри контейнера (должен совпадать с mount в docker-compose)
DOCS_DIR=/app/my-docs
# Пример: вся knowledge проекта —
# HOST_DOCS_DIR=D:/Project_AI_Assistent/knowledge
# DOCS_DIR=/app/knowledge

# Русскоязычная справка RX: multilingual E5 + BGE reranker (см. FORK.md)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# После смены embedding — новое имя коллекции или удалить cache/chromadb
CHROMA_COLLECTION_NAME=my-documents-ru-v1

USE_BM25=True
BM25_WEIGHT=0.35
USE_RERANKER=True
RERANKER_TOP_N=50

FULL_SCAN_ON_BOOT=False
FOLDER_WATCHER_ACTIVE_ON_BOOT=True

MCP_PORT=38777
