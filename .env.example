# Скопируйте в .env:  copy .env.example .env  (в папке repo\)

# --- Папка с документами (Docker) ---
# HOST_DOCS_DIR — где лежат PDF/Word на диске (путь относительно repo или D:/...)
HOST_DOCS_DIR=./docs-for-index
# DOCS_DIR — тот же каталог внутри контейнера (правая часть volume в docker-compose)
DOCS_DIR=/app/docs-for-index

# --- Модели поиска (эмбеддинги и переранжирование) ---
# EMBEDDING_MODEL — модель смыслового поиска (Hugging Face)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# EMBEDDING_DIMENSION — размерность вектора (должна совпадать с моделью)
EMBEDDING_DIMENSION=768
# RERANKER_MODEL — модель уточнения порядка результатов
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- База векторов (ChromaDB) ---
# CHROMA_COLLECTION_NAME — имя коллекции; после смены модели задайте новое имя или очистите cache/chromadb
CHROMA_COLLECTION_NAME=docs-for-index-v1

# --- Гибрид BM25 (в коде пока не используется, зарезервировано) ---
# USE_BM25 — включить BM25 при появлении реализации
USE_BM25=True
# BM25_WEIGHT — вес лексического поиска в гибриде (0–1)
BM25_WEIGHT=0.35

# --- Reranker ---
# USE_RERANKER — пересортировка top-N результатов cross-encoder
USE_RERANKER=True
# RERANKER_TOP_N — сколько кандидатов отдавать на rerank
RERANKER_TOP_N=50

# --- Поведение при старте MCP ---
# FULL_SCAN_ON_BOOT — полная переиндексация при каждом запуске сервера
FULL_SCAN_ON_BOOT=False
# FOLDER_WATCHER_ACTIVE_ON_BOOT — следить за папкой документов и подхватывать изменения
FOLDER_WATCHER_ACTIVE_ON_BOOT=True

# --- Сеть MCP ---
# MCP_PORT — порт HTTP MCP на хосте (Cursor: http://127.0.0.1:ПОРТ/mcp)
MCP_PORT=38777
